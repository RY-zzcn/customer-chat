# ============ 系统级配置（必填） ============

# 服务端口
PORT=3000

# 管理员密码（首次启动时设置，之后可在管理后台修改）
ADMIN_PASSWORD=admin123

# 会话密钥（部署时请替换为随机字符串，留空则自动生成）
# SESSION_SECRET=your_random_secret_here

# 数据持久化目录（Docker 部署时建议设为 /app/data）
# DATA_DIR=./data

# ============ 以下配置已迁移至管理后台 ============
# 邮件通知和 AI 机器人配置现在可以通过管理后台实时修改，无需重启服务。
# 部署后请登录管理后台 → 设置 → 配置邮件/AI。
